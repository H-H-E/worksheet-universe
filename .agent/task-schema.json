{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worksheet Universe Agent Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "branch",
    "priority",
    "status",
    "lane",
    "goal",
    "acceptance",
    "commands",
    "max_attempts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^\\d{3}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "branch": {
      "type": "string",
      "pattern": "^agent/\\d{3}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "priority": { "type": "integer", "minimum": 1 },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "passed", "failed", "partial", "blocked"]
    },
    "lane": {
      "type": "string",
      "enum": ["core", "rendering", "frontend", "docs", "review"]
    },
    "allowed_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "goal": { "type": "string", "minLength": 1 },
    "context": { "type": "string" },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{3}-[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "notes": { "type": "string" }
  }
}
